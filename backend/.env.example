# Leave GEMINI_API_KEY empty to run fully offline (dictionary extraction, template pathway).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=15
# Required for POST /api/signals/import. Use a long random string.
ADMIN_TOKEN=
# Postgres connection string (Supabase "Session pooler" URI). Empty = local SQLite file.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
# Optional pattern for hosts that serve one site under many addresses, e.g. Vercel:
# CORS_ORIGIN_REGEX=https://laluan(-[a-z0-9]+)*\.vercel\.app
# Sent to OpenAlex as a polite contact address (optional).
CONTACT_EMAIL=
