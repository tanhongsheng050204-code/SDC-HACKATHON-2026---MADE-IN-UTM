# Backend settings. Copy this file to backend/.env and fill in your values:
#     cp backend/.env.example backend/.env        (PowerShell: Copy-Item backend\.env.example backend\.env)
# backend/.env is git-ignored: never commit real keys. On Replit, put the same keys in the Secrets tab instead.
# Everything is optional for a local run: with all blanks the app works offline on a local SQLite file.

# --- Google Gemini (CV reading, coach, pathway summary, proof-check questions) -----------------
# Get a key at https://aistudio.google.com/apikey . Empty = offline mode (dictionary + templates,
# proof checks show "unavailable"). Use a paid-tier key for the public demo: Google does not use
# paid-tier requests to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=15

# --- RunPod Serverless (optional: open-model CV reading and voice input) ----------------------------
# With an open model configured, CV text goes to it instead of Gemini, so Gemini only ever sees
# confirmed skills. Fallback order: RunPod -> Gemini (scrubbed) -> offline dictionary.
# API key: RunPod console -> Settings -> API Keys (one key calls both endpoints).
# Endpoint IDs: Serverless -> your endpoint. Set-up used by the team: vLLM quick deploy with
# Qwen/Qwen2.5-7B-Instruct on a 24 GB GPU, MAX_MODEL_LEN=8192; faster-whisper from the Hub on 16 GB.
# Workers: active 0, max 1, so you only pay while a request runs.
RUNPOD_API_KEY=
# A vLLM worker endpoint serving an open instruct model (model name as the worker loaded it).
RUNPOD_LLM_ENDPOINT=
RUNPOD_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# A faster-whisper worker endpoint. Empty = the browser's own speech recognition, then typing.
RUNPOD_WHISPER_ENDPOINT=
RUNPOD_WHISPER_MODEL=small
# Limit for the whole call. Short on purpose: a cold start falls back instead of making the person wait.
RUNPOD_TIMEOUT_SECONDS=20

# --- Admin (Refresh trend data, approve or reject snapshots) -------------------------------------
# Any long random string, e.g. the output of:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Supabase database ---------------------------------------------------------------------------
# Supabase dashboard -> project "laluan" -> Connect -> "Session pooler" URI, with your database
# password in place of [YOUR-PASSWORD] (reset it under Project Settings -> Database if you need to).
# Shape: postgresql://postgres.cxzcyumodnhjvlutvzyn:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Empty = local SQLite file at backend/laluan.db (fine for development; Replit needs Supabase).
DATABASE_URL=

# --- Supabase login (Google) -----------------------------------------------------------------------
# The project URL. Login tokens are checked against its public signing keys, so no secret is needed.
SUPABASE_URL=https://cxzcyumodnhjvlutvzyn.supabase.co
# Leave empty: the laluan project signs logins with public (ES256) keys. Only for older projects
# that still use the legacy shared JWT secret.
SUPABASE_JWT_SECRET=

# --- Browser access (only when the frontend runs on a different address) --------------------------
# Local development: the Vite dev server on port 5173 calls the API on port 8000.
CORS_ORIGINS=http://localhost:5173
# Optional pattern for hosts that serve one site under many addresses:
# CORS_ORIGIN_REGEX=https://laluan(-[a-z0-9]+)*\.vercel\.app

# --- Optional ----------------------------------------------------------------------------------------
# Sent to OpenAlex as a polite contact address when refreshing research trends.
CONTACT_EMAIL=
