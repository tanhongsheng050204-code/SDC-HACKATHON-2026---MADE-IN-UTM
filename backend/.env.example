# Leave GEMINI_API_KEY empty to run fully offline (dictionary extraction, template pathway).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=15
# Required for POST /api/signals/import. Use a long random string.
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173
