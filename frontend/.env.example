# Frontend settings. Copy this file to frontend/.env and fill in your values:
#     cp frontend/.env.example frontend/.env      (PowerShell: Copy-Item frontend\.env.example frontend\.env)
# frontend/.env is git-ignored. Vite builds these values INTO the app, so only put public values
# here (never a Gemini key, database password or admin token: those belong in backend/.env).
# On Vercel, add the same keys under Settings -> Environment Variables, then redeploy.

# Where the API lives. Leave empty in development (Vite forwards /api to localhost:8000).
# On Vercel: the Render address without /api, e.g. https://laluan-api.onrender.com
VITE_API_URL=

# Google login through Supabase. Leave both empty to hide the login button (anonymous use only).
# URL: your Supabase project URL.
VITE_SUPABASE_URL=https://cxzcyumodnhjvlutvzyn.supabase.co
# Key: Supabase dashboard -> project "laluan" -> Project Settings -> API Keys -> Legacy API keys -> "anon".
# It is public by design (row-level security keeps the tables closed to it).
VITE_SUPABASE_ANON_KEY=

# Error tracking (optional): a Sentry project's DSN. Empty = off, and the Sentry code is never loaded.
# Events lose the user, breadcrumbs and query strings before they are sent.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# "Sign in with Microsoft" for school and work accounts. Set to 1 only after the Azure provider is
# switched on in Supabase (Authentication -> Providers -> Azure); otherwise leave empty.
VITE_AUTH_MICROSOFT=
