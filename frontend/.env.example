# Leave empty in development (Vite proxies /api to localhost:8000) and on Replit (same address as the API).
# Set it only when the frontend is hosted separately from the backend.
VITE_API_URL=
# Supabase project URL and anon (public) key, for Google login. Leave empty to hide login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
